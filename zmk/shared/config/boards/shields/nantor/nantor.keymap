#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <zmk_behavior_status_led/modes.h>

#define L_CLM 0
#define L_QWT 1
#define L_NUM 2
#define L_FNS 3
#define L_CFG 4

/ {
    keymap {
      compatible = "zmk,keymap";

     /*
      *     ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
      * ┌───┤ Q │ W │ F │ P │ B │      │ J │ L │ U │ Y │ ; ├───┐
      * │Esc├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤ ' │
      * ├───┤ A │ R │ S │ T │ G │      │ M │ N │ E │ I │ O ├───┤
      * │Alt├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤ \ │
      * └───┤ Z │ X │ C │ D │ V │      │ K │ H │ , │ . │ / ├───┘
      *     └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
      *           ┌───┬───┬───┬───┐  ┌───┬───┬───┬───┐
      *           │Bsp│Spc│Sft│ ⌘ │  │Ctl│NUM│Ent│FNS│
      *           └───┴───┴───┴───┘  └───┴───┴───┴───┘
      */
      colemak {
        bindings =
        <
                  &kp Q     &kp W     &kp F     &kp P     &kp B         &kp J     &kp L     &kp U     &kp Y     &kp SEMI
        &kp ESC   &kp A     &kp R     &kp S     &kp T     &kp G         &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
        &kp LALT  &kp Z     &kp X     &kp C     &kp D     &kp V         &kp K     &kp H     &kp COMMA &kp DOT   &kp FSLH  &kp BSLH
                            &kp BSPC  &kp SPACE &kp LSHFT &kp LGUI      &kp LCTRL &mo L_NUM &kp ENTER &mo L_FNS
        >;
      };

     /*
      *     ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
      * ┌───┤ Q │ W │ E │ R │ T │      │ Y │ U │ I │ O │ P ├───┐
      * │Esc├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤ ' │
      * ├───┤ A │ S │ D │ F │ G │      │ H │ J │ K │ L │ ; ├───┤
      * │Alt├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤ \ │
      * └───┤ Z │ X │ C │ V │ B │      │ N │ M │ , │ . │ / ├───┘
      *     └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
      *           ┌───┬───┬───┬───┐  ┌───┬───┬───┬───┐
      *           │Bsp│Spc│Sft│ ⌘ │  │Ctl│NUM│Ent│FNS│
      *           └───┴───┴───┴───┘  └───┴───┴───┴───┘
      */
      qwerty {
        bindings =
        <
                  &kp Q     &kp W     &kp E     &kp R     &kp T         &kp Y     &kp U     &kp I     &kp O     &kp P
        &kp ESC   &kp A     &kp S     &kp D     &kp F     &kp G         &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
        &kp LALT  &kp Z     &kp X     &kp C     &kp V     &kp B         &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp BSLH
                            &kp BSPC  &kp SPACE &kp LSHFT &kp LGUI      &kp LCTRL &mo L_NUM &kp ENTER &mo L_FNS
        >;
      };

      numbers {
     /*
      *     ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
      * ┌───┤ = │ 7 │ 8 │ 9 │ 0 │      │Hom│PDn│PUp│End│Sft├───┐
      * │Esc├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤Ctl│
      * ├───┤ - │ 4 │ 5 │ 6 │ [ │      │ ← │ ↓ │ ↑ │ → │ ⌘ ├───┤
      * │Alt├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤Alt│
      * └───┤ ` │ 1 │ 2 │ 3 │ ] │      │Del│Tab│ , │ . │ / ├───┘
      *     └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
      *           ┌───┬───┬───┬───┐  ┌───┬───┬───┬───┐
      *           │Bsp│Spc│Sft│ ⌘ │  │Ctl│ ∆ │Ent│CFG│
      *           └───┴───┴───┴───┘  └───┴───┴───┴───┘
      */
        bindings =
        <
                  &kp EQUAL &kp N7    &kp N8    &kp N9    &kp N0        &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp RSHFT
        &kp ESC   &kp MINUS &kp N4    &kp N5    &kp N6    &kp LBKT      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp RGUI  &kp RCTRL
        &kp LALT  &kp GRAVE &kp N1    &kp N2    &kp N3    &kp RBKT      &kp DEL   &kp TAB   &kp COMMA &kp DOT   &kp FSLH  &kp RALT
                            &kp BSPC  &kp SPACE &kp LSHFT &kp LGUI      &kp LCTRL &trans    &kp ENTER &mo L_CFG
        >;
      };

      functions {
     /*
      *     ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
      * ┌───┤Ins│ F9│F10│F11│F12│      │   │-B │+B │   │Sft├───┐
      * │Esc├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤Ctl│
      * ├───┤Cap│ F5│ F6│ F7│ F8│      │   │ ◄ │ ‖ │ ► │ ⌘ ├───┤
      * │Alt├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤Alt│
      * └───┤PSc│ F1│ F2│ F3│ F4│      │   │-V │ V0│+V │   ├───┘
      *     └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
      *           ┌───┬───┬───┬───┐  ┌───┬───┬───┬───┐
      *           │Bsp│Spc│Sft│ ⌘ │  │Ctl│CFG│Ent│ ∆ │
      *           └───┴───┴───┴───┘  └───┴───┴───┴───┘
      */

        bindings =
        <
                  &kp INS   &kp F9    &kp F10   &kp F11   &kp F12       &none     &kp C_BRI_DN &kp C_BRI_UP &none        &kp RSHFT
        &kp ESC   &kp CAPS  &kp F5    &kp F6    &kp F7    &kp F8        &none     &kp C_PREV   &kp C_PP     &kp C_NEXT   &kp RGUI  &kp RCTRL
        &kp LALT  &kp PSCRN &kp F1    &kp F2    &kp F3    &kp F4        &none     &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &none     &kp RALT
                            &kp BSPC  &kp SPACE &kp LSHFT &kp LGUI      &kp LCTRL &mo L_CFG    &kp ENTER    &trans
        >;
      };

      config {
     /*
      *     ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
      * ┌───┤   │   │   │   │BTC│      │   │   │   │   │   ├───┐
      * │   ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤CLM│
      * ├───┤BLE│BT3│BT4│   │   │      │   │   │   │   │   ├───┤
      * │   ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤QWT│
      * └───┤USB│BT0│BT1│BT2│   │      │   │   │   │   │   ├───┘
      *     └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
      *           ┌───┬───┬───┬───┐  ┌───┬───┬───┬───┐
      *           │   │   │   │   │  │ 󱐋 │ ∆ │ 󰂯 │ ∆ │
      *           └───┴───┴───┴───┘  └───┴───┴───┴───┘
      */

        bindings =
        <
              &none        &none        &none        &none        &bt BT_CLR    &none          &none  &none           &none  &none
        &none &out OUT_BLE &bt BT_SEL 3 &bt BT_SEL 4 &none        &none         &none          &none  &none           &none  &none &to L_CLM
        &none &out OUT_USB &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none         &none          &none  &none           &none  &none &to L_QWT
                           &none        &none        &none        &none         &st_led ST_BAT &trans &st_led ST_CON  &trans
        >;
      };
    };
};
